# Shazam is OFF by default. To enable: pip install shazamio, then set USE_SHAZAM=true
USE_SHAZAM=false # optional

# Optional YouTube authentication; configure only one.
# Use a browser logged in to YouTube (e.g. chrome, firefox, edge):
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# Or use a private Netscape-format cookies.txt file. Relative paths are from backend/:
# YOUTUBE_COOKIES_FILE=C:/Users/you/cookies.txt

# Default: free Pollinations endpoint (no key). Refer: https://console.groq.com/docs/models, Groq free tier example:
# [Method 1: Use Groq free tier]
LLM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b # llama-3.1-8b-instant
LLM_KEY=<YOUR_GROQ_API_KEY>

# [Method 2: Use Pollinations (free)]
# LLM_URL=https://text.pollinations.ai/openai
# LLM_MODEL=openai
# LLM_KEY=

# Parameters for DDGS
MAX_DDGS_IMAGES_PER_QUERY=5
FINAL_IMAGE_SNIPPET_CAP=5
MAX_DDGS_TEXT_PER_QUERY=5
FINAL_TEXT_SNIPPET_CAP=8

# Parameters for YouTube access
# YOUTUBE_COOKIES_FROM_BROWSER=chrome # Options: chrome, firefox, safari, edge, brave, opera